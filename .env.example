# Copy to .env (Windows: copy .env.example .env) before `docker compose up`

# REQUIRED: any long random string (e.g. run: openssl rand -base64 32)
JWT_SECRET=change_me_to_a_long_random_string

# Host port for the web app (default 3000)
WEB_PORT=3000

# Set true only when the site is served over HTTPS
COOKIE_SECURE=false

# OPTIONAL: needed only for image messages + profile pictures.
# Leave blank to run text-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
