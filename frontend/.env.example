# Normally leave these unset: the app calls relative /api and /socket.io,
# which the Vite dev proxy (dev), nginx (Docker) or Express (Render) serve.

# Local (non-Docker) dev: where the Vite dev server proxies to
VITE_PROXY_TARGET=http://localhost:5001

# Vercel (frontend) + Render (API) ONLY: set this in the Vercel project's
# Environment Variables to your Render URL. REST goes through the rewrite in
# vercel.json; WebSockets connect straight to this URL (Vercel can't proxy them).
# VITE_SOCKET_URL=https://your-service.onrender.com

# Only if the API is on another origin and you are NOT using a proxy/rewrite:
# VITE_API_URL=https://your-service.onrender.com
