# --- Required ---
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/chatapp
JWT_SECRET=replace_this_with_a_long_random_secret
# Browser origin(s) allowed (CORS + sockets); comma-separate several. On Render
# this is optional: RENDER_EXTERNAL_URL is used automatically.
CLIENT_URL=http://localhost:5173

# --- Optional ---
NODE_ENV=development
# Set to true once the site is served over HTTPS
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (nginx in Docker = 1)
TRUST_PROXY=0

# Image messages + profile pictures. Leave blank to run text-only
# (uploading will return a clear "not configured" message).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
